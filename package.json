{
  "name": "usv-chartlite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A clean standalone chart of the Singapore Strait. One tab, one map, no archive.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "serve": "node serve.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^26.0.0",
    "maplibre-gl": "5.9.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^2.1.0"
  }
}
